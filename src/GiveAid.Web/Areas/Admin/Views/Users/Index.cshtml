@model List<GiveAid.Web.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Registered Community Users";
    var selectedRole = ViewBag.SelectedRole as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Registered Community Users</h3>
        <p class="text-muted small mb-0">Manage registered members and system administrators.</p>
    </div>
</div>

<!-- Role Filter -->
<div class="custom-card p-3 mb-4 shadow-sm">
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selectedRole) ? "btn-primary-custom" : "btn-outline-secondary")">
            All Users (@Model.Count)
        </a>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-role="Member" class="btn btn-sm @(selectedRole == "Member" ? "btn-primary-custom" : "btn-outline-secondary")">
            Members
        </a>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-role="Admin" class="btn btn-sm @(selectedRole == "Admin" ? "btn-primary-custom" : "btn-outline-secondary")">
            Administrators
        </a>
    </div>
</div>

<div class="custom-card p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>City / Profession</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Toggle Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@user.FullName</div>
                            <small class="text-muted">@user.Email</small>
                        </td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-warning text-dark" : "bg-info text-dark")">
                                @user.Role
                            </span>
                        </td>
                        <td class="small">
                            <div>@(user.City ?? "N/A")</div>
                            <small class="text-muted">@(user.Profession ?? "N/A")</small>
                        </td>
                        <td class="small text-muted">@(user.PhoneNumber ?? "N/A")</td>
                        <td>
                            <span class="badge @(user.Status == "Active" ? "badge-status-active" : "badge-status-suspended")">
                                @user.Status
                            </span>
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <form asp-area="Admin" asp-controller="Users" asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(user.Status == "Active" ? "btn-outline-danger" : "btn-outline-success")">
                                    @(user.Status == "Active" ? "Suspend" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
