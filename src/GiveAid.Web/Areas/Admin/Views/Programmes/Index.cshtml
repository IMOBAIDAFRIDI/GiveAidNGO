@model List<GiveAid.Web.Models.Entities.Programme>
@{
    ViewData["Title"] = "Manage Programmes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Humanitarian Field Programmes</h3>
        <p class="text-muted small mb-0">Schedule field initiatives, upload campaign banners, and track registrations.</p>
    </div>
    <a asp-area="Admin" asp-controller="Programmes" asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle me-1"></i> Add Programme
    </a>
</div>

<div class="custom-card p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Start Date</th>
                    <th>Location</th>
                    <th>Registrations</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold">@p.Title</td>
                        <td><span class="badge bg-light text-dark border">@p.Category</span></td>
                        <td class="small">@p.StartAt.ToString("dd MMM yyyy")</td>
                        <td class="small text-muted">@(p.Location ?? "N/A")</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Interests" asp-action="Index" asp-route-programmeId="@p.Id" class="badge bg-primary text-decoration-none">
                                @p.Interests.Count Registered
                            </a>
                        </td>
                        <td>
                            <span class="badge @(p.Status == "Published" ? "badge-status-published" : "badge-status-closed")">
                                @p.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-area="Admin" asp-controller="Programmes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Programmes" asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Soft-delete this programme?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
