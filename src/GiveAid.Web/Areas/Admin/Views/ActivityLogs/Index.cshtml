@model List<GiveAid.Web.Models.Entities.AdminActivityLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">System Audit Trail &amp; Activity Logs</h3>
        <p class="text-muted small mb-0">Immutable records of administrative actions, edits, and state transitions.</p>
    </div>
</div>

<div class="custom-card p-4 shadow-sm">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Administrator</th>
                        <th>Action Performed</th>
                        <th>Entity Type</th>
                        <th>Target ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-muted font-monospace">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@(log.AdminUser?.FullName ?? "System Admin")</td>
                            <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                            <td class="fw-bold text-primary">@log.EntityType</td>
                            <td class="font-monospace">@(log.EntityId.HasValue ? $"#{log.EntityId}" : "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <p class="mb-0">No administrative logs recorded yet.</p>
        </div>
    }
</div>
