@model GiveAid.Web.Models.Entities.Cause
@{
    ViewData["Title"] = "Edit Cause - " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Edit Cause</h3>
        <p class="text-muted small mb-0">Update cause specifications and funding goal.</p>
    </div>
    <a asp-area="Admin" asp-controller="Causes" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Back to Causes
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5 shadow-sm">
            <form asp-area="Admin" asp-controller="Causes" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label fw-semibold"></label>
                    <input asp-for="Slug" class="form-control" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetAmount" class="form-label fw-semibold">Target Goal ($)</label>
                    <input asp-for="TargetAmount" type="number" step="100.00" class="form-control" />
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Appeal</label>
                </div>

                <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">
                    <i class="bi bi-check2-circle me-1"></i> Update Cause
                </button>
            </form>
        </div>
    </div>
</div>
