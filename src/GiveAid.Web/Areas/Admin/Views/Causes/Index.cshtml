@model List<GiveAid.Web.Models.Entities.Cause>
@{
    ViewData["Title"] = "Manage Causes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Relief Causes &amp; Appeals</h3>
        <p class="text-muted small mb-0">Create, edit, toggle, and soft-delete humanitarian causes.</p>
    </div>
    <a asp-area="Admin" asp-controller="Causes" asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle me-1"></i> Add New Cause
    </a>
</div>

<div class="custom-card p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Cause Name</th>
                    <th>Slug</th>
                    <th>Target</th>
                    <th>Raised</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cause in Model)
                {
                    <tr>
                        <td class="fw-bold">@cause.Name</td>
                        <td class="text-muted font-monospace small">@cause.Slug</td>
                        <td class="fw-semibold">$@cause.TargetAmount.ToString("N0")</td>
                        <td class="fw-bold text-success">$@cause.RaisedAmount.ToString("N0")</td>
                        <td>
                            <form asp-area="Admin" asp-controller="Causes" asp-action="ToggleStatus" asp-route-id="@cause.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(cause.IsActive ? "badge-status-active" : "badge-status-closed") border-0">
                                    @(cause.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-area="Admin" asp-controller="Causes" asp-action="Edit" asp-route-id="@cause.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-area="Admin" asp-controller="Causes" asp-action="Delete" asp-route-id="@cause.Id" method="post" onsubmit="return confirm('Are you sure you want to soft-delete this cause?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
