@model List<GiveAid.Web.Models.Entities.Query>
@{
    ViewData["Title"] = "Help Queries & Support Tickets";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Help Queries &amp; Support Tickets</h3>
        <p class="text-muted small mb-0">Review questions submitted by members and public guests.</p>
    </div>
</div>

<!-- Status Filter -->
<div class="custom-card p-3 mb-4 shadow-sm">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small fw-bold text-uppercase me-2">Status:</span>
        <a asp-area="Admin" asp-controller="Queries" asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary-custom" : "btn-outline-secondary")">
            All Tickets
        </a>
        <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="Open" class="btn btn-sm @(selectedStatus == "Open" ? "btn-primary-custom" : "btn-outline-secondary")">
            Open Tickets
        </a>
        <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="Answered" class="btn btn-sm @(selectedStatus == "Answered" ? "btn-primary-custom" : "btn-outline-secondary")">
            Answered
        </a>
        <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="Closed" class="btn btn-sm @(selectedStatus == "Closed" ? "btn-primary-custom" : "btn-outline-secondary")">
            Closed
        </a>
    </div>
</div>

<div class="custom-card p-4 shadow-sm">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>#</th>
                        <th>Sender</th>
                        <th>Subject</th>
                        <th>Replies</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@q.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@q.Name</div>
                                <small class="text-muted">@q.Email</small>
                            </td>
                            <td class="fw-semibold">@q.Subject</td>
                            <td>
                                <span class="badge bg-light text-secondary border">@q.Replies.Count Replies</span>
                            </td>
                            <td>
                                <span class="badge @(q.Status == "Answered" ? "badge-status-successful" : q.Status == "Open" ? "badge-status-pending" : "badge-status-closed")">
                                    @q.Status
                                </span>
                            </td>
                            <td class="small text-muted">@q.CreatedAt.ToString("dd MMM, HH:mm")</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Queries" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-reply me-1"></i> View &amp; Reply
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <p class="mb-0">No queries found matching the selected filter.</p>
        </div>
    }
</div>
