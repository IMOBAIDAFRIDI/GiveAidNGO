@model GiveAid.Web.Models.Entities.NGO
@{
    ViewData["Title"] = "Add Associated NGO";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Add Associated NGO</h3>
    </div>
    <a asp-area="Admin" asp-controller="NGOs" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Back to NGOs
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5 shadow-sm">
            <form asp-area="Admin" asp-controller="NGOs" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Al-Noor Literacy Initiative" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Lahore" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+92 42 37654321" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="info@alnoor.org" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label fw-semibold"></label>
                        <input asp-for="Website" type="url" class="form-control" placeholder="https://alnoor.org" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <textarea asp-for="Address" rows="2" class="form-control"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active in Public Directory</label>
                </div>

                <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">Save NGO Record</button>
            </form>
        </div>
    </div>
</div>
