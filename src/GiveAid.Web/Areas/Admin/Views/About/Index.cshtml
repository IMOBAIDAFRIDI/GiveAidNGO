@model List<GiveAid.Web.Models.Entities.AboutSection>
@{
    ViewData["Title"] = "Manage About Us Content";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">About Us Content Model (7 Canonical Sections)</h3>
        <p class="text-muted small mb-0">Manage the 7 unified sections rendered across the public About portal.</p>
    </div>
</div>

<div class="custom-card p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Order</th>
                    <th>Section Title</th>
                    <th>Slug</th>
                    <th>Excerpt</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sec in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@sec.SortOrder</td>
                        <td class="fw-bold text-dark">@sec.Title</td>
                        <td><code class="text-primary">@sec.Slug</code></td>
                        <td class="small text-muted" style="max-width: 320px;">
                            @(sec.Content.Length > 85 ? sec.Content[..85] + "..." : sec.Content)
                        </td>
                        <td>
                            <span class="badge @(sec.IsActive ? "badge-status-active" : "badge-status-closed")">
                                @(sec.IsActive ? "Active" : "Hidden")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="About" asp-action="Edit" asp-route-id="@sec.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Edit Content
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
