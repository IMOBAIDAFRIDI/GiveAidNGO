@model GiveAid.Web.Models.ViewModels.About.AboutSectionCreateViewModel
@{
    ViewData["Title"] = "Add New About Section";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Add New About Section</h3>
        <p class="text-muted small mb-0">Create a new core pillar or informative section for the public About Us page.</p>
    </div>
    <a asp-area="Admin" asp-controller="About" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Sections
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5 shadow-sm">
            <form asp-area="Admin" asp-controller="About" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Section Title</label>
                    <input asp-for="Title" class="form-control form-control-lg" id="sectionTitle" placeholder="e.g. Humanitarian Relief Caravans" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label fw-semibold">URL Slug</label>
                    <div class="input-group">
                        <span class="input-group-text bg-surface border-secondary border-opacity-25 text-muted">/about/</span>
                        <input asp-for="Slug" class="form-control font-monospace" id="sectionSlug" placeholder="e.g. humanitarian-caravans" required />
                    </div>
                    <small class="text-muted d-block mt-1">Lowercase letters, numbers, and hyphens only.</small>
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SortOrder" class="form-label fw-semibold">Display Order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active &amp; Visible on Website</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="ImageFile" class="form-label fw-semibold">Cover Photo (Optional)</label>
                    <input type="file" asp-for="ImageFile" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                    <small class="text-muted">High-resolution landscape image (JPG, PNG, WEBP, max 5MB).</small>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold">Body Content / Description</label>
                    <textarea asp-for="Content" rows="8" class="form-control" placeholder="Provide full details, mission objectives, and impact figures for this section..." required style="line-height: 1.6;"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Create Section
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const titleInput = document.getElementById('sectionTitle');
            const slugInput = document.getElementById('sectionSlug');
            let manualSlug = false;

            slugInput.addEventListener('input', () => {
                manualSlug = true;
            });

            titleInput.addEventListener('input', () => {
                if (!manualSlug) {
                    slugInput.value = titleInput.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^a-z0-9\s-]/g, '')
                        .replace(/[\s-]+/g, '-');
                }
            });
        });
    </script>
}
