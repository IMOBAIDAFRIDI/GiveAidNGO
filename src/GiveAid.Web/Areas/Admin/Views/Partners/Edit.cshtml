@model GiveAid.Web.Models.Entities.Partner
@{
    ViewData["Title"] = "Edit Partner - " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Edit Partner</h3>
    </div>
    <a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Back to Partners
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5 shadow-sm">
            <form asp-area="Admin" asp-controller="Partners" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="LogoPath" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label fw-semibold"></label>
                    <input asp-for="Slug" class="form-control" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Website" class="form-label fw-semibold"></label>
                    <input asp-for="Website" type="url" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="logoFile" class="form-label fw-semibold">Replace Logo (Optional)</label>
                    <input type="file" name="logoFile" id="logoFile" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="SortOrder" class="form-label fw-semibold">Sort Order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">Update Partner</button>
            </form>
        </div>
    </div>
</div>
