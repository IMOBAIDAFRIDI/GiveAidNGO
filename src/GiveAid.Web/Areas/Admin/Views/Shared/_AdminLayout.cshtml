<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('giveaid_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIVE-AID Admin CMS</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Admin Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-brand d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-warning"></i>
                <span>GIVE-AID CMS</span>
            </div>

            <nav class="nav flex-column py-2">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="sidebar-heading">Content &amp; CMS</div>
                <a class="nav-link" asp-area="Admin" asp-controller="Causes" asp-action="Index">
                    <i class="bi bi-flag-fill"></i> Causes
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Programmes" asp-action="Index">
                    <i class="bi bi-calendar-event"></i> Programmes
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Interests" asp-action="Index">
                    <i class="bi bi-person-check"></i> Member Interests
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="About" asp-action="Index">
                    <i class="bi bi-file-text"></i> About Sections
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Partners" asp-action="Index">
                    <i class="bi bi-building"></i> Partners
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="NGOs" asp-action="Index">
                    <i class="bi bi-globe2"></i> Associated NGOs
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Gallery" asp-action="Index">
                    <i class="bi bi-images"></i> Gallery Images
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Contact" asp-action="Index">
                    <i class="bi bi-geo-alt"></i> Contact Details
                </a>

                <div class="sidebar-heading">Finance &amp; Audits</div>
                <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index">
                    <i class="bi bi-cash-stack"></i> All Donations
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="ActivityLogs" asp-action="Index">
                    <i class="bi bi-clock-history"></i> Admin Activity Logs
                </a>

                <div class="sidebar-heading">Users &amp; Inquiries</div>
                <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> Registered Users
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Queries" asp-action="Index">
                    <i class="bi bi-chat-dots"></i> Help Queries &amp; Replies
                </a>

                <div class="sidebar-heading">Navigation</div>
                <a class="nav-link text-info" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-arrow-up-right"></i> View Public Site
                </a>
            </nav>
        </aside>

        <!-- Admin Main Content -->
        <div class="admin-content">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-custom px-2 py-1">Admin Portal</span>
                    <span class="text-muted small">| Logged in as: <strong>@(User.Identity?.Name ?? "Administrator")</strong></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <!-- Theme Switcher -->
                    <button class="btn btn-sm btn-outline-custom rounded-circle p-0 d-flex align-items-center justify-content-center" id="themeToggleBtn" type="button" title="Switch Theme" style="width: 32px; height: 32px;">
                        <i class="bi bi-moon-stars-fill text-info" id="themeIcon"></i>
                    </button>
                    <span class="text-muted small d-none d-md-inline ms-1"><i class="bi bi-calendar3 me-1"></i> @DateTime.UtcNow.ToString("dd MMM yyyy")</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </header>

            <div class="p-4 flex-grow-1">
                <partial name="_FlashMessage" />
                @RenderBody()
            </div>

            <footer class="bg-white border-top py-2 px-4 text-center text-muted small">
                GIVE-AID Management System &bull; Admin CMS &bull; Secure ASP.NET Core MVC Layer
            </footer>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- Chart.js for dashboard charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
