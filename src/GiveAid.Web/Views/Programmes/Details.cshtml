@model GiveAid.Web.Models.ViewModels.Programmes.ProgrammeDetailsViewModel
@{
    ViewData["Title"] = Model.Programme.Title;
    var bannerImg = !string.IsNullOrEmpty(Model.Programme.ImagePath) 
        ? Model.Programme.ImagePath 
        : "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop";
}

<!-- Page Header Banner -->
<div class="page-header-banner text-white mb-5">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-controller="Programme" asp-action="Index" class="text-white text-decoration-none small opacity-75 hover-white">
                &larr; Back to Programmes
            </a>
            <span class="text-white-50">/</span>
            <span class="badge bg-secondary-custom text-uppercase rounded-pill">@Model.Programme.Category</span>
        </div>
        <h1 class="display-5 fw-bold text-white mb-2">@Model.Programme.Title</h1>
        <p class="lead text-muted mb-0">
            <i class="bi bi-calendar-event me-2 text-primary"></i> Starts on @Model.Programme.StartAt.ToString("dddd, dd MMMM yyyy")
            @if (!string.IsNullOrEmpty(Model.Programme.Location))
            {
                <span class="ms-3"><i class="bi bi-geo-alt me-1 text-danger"></i> @Model.Programme.Location</span>
            }
        </p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="custom-card p-0 shadow-lg mb-4 overflow-hidden">
                <!-- Programme Banner Image -->
                <div style="height: 360px; width: 100%; overflow: hidden;">
                    <img src="@bannerImg" alt="@Model.Programme.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>

                <div class="p-4 p-lg-5">
                    <h4 class="fw-bold mb-3 text-white">Mission Scope &amp; Community Impact</h4>
                    <div class="lead text-muted mb-4" style="line-height: 1.85;">
                        @Model.Programme.Description
                    </div>

                    <div class="p-4 bg-surface rounded-4 border mb-4">
                        <h5 class="fw-bold mb-3 text-white"><i class="bi bi-info-circle-fill text-primary me-2"></i> Field Logistics &amp; Schedule</h5>
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                            <li><strong class="text-white">Category:</strong> @Model.Programme.Category</li>
                            <li><strong class="text-white">Start Date:</strong> @Model.Programme.StartAt.ToString("f")</li>
                            @if (Model.Programme.EndAt.HasValue)
                            {
                                <li><strong class="text-white">Projected Completion:</strong> @Model.Programme.EndAt.Value.ToString("f")</li>
                            }
                            <li><strong class="text-white">Field District / Venue:</strong> @(Model.Programme.Location ?? "To be confirmed by regional coordinators")</li>
                            <li><strong class="text-white">Status:</strong> <span class="badge bg-success rounded-pill">@Model.Programme.Status</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registration Card / Side Box -->
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-lg sticky-top" style="top: 85px;">
                <h5 class="fw-bold mb-2 text-white">Participate in this Mission</h5>
                <p class="text-muted small mb-3">
                    Register your interest as a volunteer or supporter. Our community outreach desk will coordinate with you.
                </p>

                <div class="p-3 bg-surface rounded-3 border text-center mb-4">
                    <span class="d-block fs-3 fw-bold text-primary-custom" id="interestCounterDisplay">@Model.TotalInterestsCount</span>
                    <span class="text-muted small text-uppercase fw-semibold">Community Members Registered</span>
                </div>

                @if (Model.IsAuthenticated)
                {
                    if (Model.IsUserInterested)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-0 rounded-3">
                            <i class="bi bi-check-circle-fill fs-4 text-success flex-shrink-0"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-white">You're Registered!</h6>
                                <small class="text-muted">Thank you for expressing interest in this mission.</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Member" asp-action="RegisterInterest" asp-route-id="@Model.Programme.Id" method="post" class="ajax-interest-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary-custom w-100 py-3 fw-bold rounded-pill d-flex justify-content-center align-items-center gap-2 shadow-sm">
                                <i class="bi bi-hand-thumbs-up-fill"></i>
                                <span>I'm Interested</span>
                            </button>
                        </form>
                    }
                }
                else
                {
                    <div class="text-center p-3 bg-surface rounded-3 border">
                        <i class="bi bi-lock-fill fs-3 text-muted mb-2 d-block"></i>
                        <h6 class="fw-bold mb-1 text-white">Member Sign-In Required</h6>
                        <p class="text-muted small mb-3">Please sign in to register your interest and join our team.</p>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary-custom btn-sm w-100 rounded-pill mb-2">
                            Sign In to Register
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom btn-sm w-100 rounded-pill">
                            Create Free Account
                        </a>
                    </div>
                }

                <div class="mt-4 pt-3 border-top">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Share With Friends</h6>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-custom flex-grow-1" onclick="copyProgrammeLink()">
                            <i class="bi bi-share me-1"></i> Copy Link
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyProgrammeLink() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert("Programme link copied to clipboard!");
            });
        }
    </script>
}
