<footer class="bg-dark text-white pt-5 pb-4 mt-auto border-top border-secondary">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="d-inline-flex justify-content-center align-items-center bg-primary-custom text-white rounded-circle" style="width: 34px; height: 34px;">
                        <i class="bi bi-heart-fill"></i>
                    </span>
                    <span class="fs-4 fw-bold text-white">GIVE-AID</span>
                </div>
                <p class="text-secondary small pe-lg-4">
                    GIVE-AID is an independent, non-profit humanitarian organization dedicated to protecting human dignity, advancing education, and empowering vulnerable communities across the country.
                </p>
                <div class="d-flex gap-3 text-secondary fs-5 mt-3">
                    <a href="#" class="text-secondary hover-white"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-secondary hover-white"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-secondary hover-white"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-secondary hover-white"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>

            <div class="col-lg-2 col-md-6">
                <h6 class="text-white fw-bold mb-3 text-uppercase fs-6">Quick Links</h6>
                <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="About" asp-action="Index">About Us</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Programme" asp-action="Index">Programmes</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Partner" asp-action="Index">Our Partners</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="NGO" asp-action="Index">Associated NGOs</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Gallery" asp-action="Index">Photo Gallery</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h6 class="text-white fw-bold mb-3 text-uppercase fs-6">Get Involved</h6>
                <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Donation" asp-action="Index">Make a Donation</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Account" asp-action="Register">Join As Volunteer</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="HelpCentre" asp-action="Index">Help Centre & FAQs</a></li>
                    <li><a class="text-secondary text-decoration-none hover-white" asp-controller="Contact" asp-action="Index">Contact Support</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h6 class="text-white fw-bold mb-3 text-uppercase fs-6">Newsletter & Updates</h6>
                <p class="text-secondary small mb-2">Subscribe to receive monthly on-ground photographic audit reports directly to your inbox.</p>
                <form class="mb-3" onsubmit="event.preventDefault(); this.querySelector('button').innerHTML='Subscribed!'; this.querySelector('button').disabled=true;">
                    <div class="input-group">
                        <input type="email" class="form-control form-control-sm border-0" placeholder="Your email address..." required style="background: rgba(255,255,255,0.08); font-size: 0.8rem;">
                        <button class="btn btn-primary-custom btn-sm px-3" type="submit">Join</button>
                    </div>
                </form>

                <h6 class="text-white fw-bold mb-2 text-uppercase fs-6" style="font-size: 0.75rem !important;">Headquarters</h6>
                <p class="text-secondary small mb-1"><i class="bi bi-geo-alt me-2 text-primary"></i> 12 Blue Area, Islamabad</p>
                <p class="text-secondary small mb-3"><i class="bi bi-telephone me-2 text-primary"></i> +92 (051) 234-5678</p>
                <a class="btn btn-secondary-custom btn-sm w-100" asp-controller="Donation" asp-action="Index">
                    <i class="bi bi-heart-fill me-1 text-danger"></i> Donate to Active Causes
                </a>
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 text-secondary small">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span>&copy; @DateTime.UtcNow.Year GIVE-AID NGO Management System. All rights reserved.</span>
                <span>&bull;</span>
                <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-shield-lock-fill text-success"></i> 256-Bit SSL Encrypted</span>
                <span>&bull;</span>
                <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-patch-check-fill text-info"></i> SQL-Audited Ledger</span>
            </div>
            <div class="d-flex align-items-center gap-2 fs-5 opacity-75">
                <i class="bi bi-credit-card-2-front" title="Card Payments"></i>
                <i class="bi bi-shield-check text-success" title="Verified Non-Profit"></i>
                <i class="bi bi-bank" title="Direct Bank Transfer"></i>
            </div>
        </div>
    </div>
</footer>
