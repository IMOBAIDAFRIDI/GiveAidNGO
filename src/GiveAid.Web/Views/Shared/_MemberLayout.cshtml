@{
    Layout = "_Layout";
}

<div class="container py-4 my-2">
    <div class="row g-4">
        <!-- Member Left Sidebar -->
        <div class="col-lg-3 col-md-4">
            <div class="custom-card p-3 shadow-sm">
                <div class="text-center py-3 border-bottom mb-3">
                    <div class="d-inline-flex justify-content-center align-items-center bg-primary-custom text-white rounded-circle fs-3 mb-2" style="width: 64px; height: 64px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@(User.Identity?.Name?.Split('@')[0] ?? "Member")</h5>
                    <span class="badge bg-light text-secondary border mt-1">Verified Member</span>
                </div>

                <div class="list-group list-group-flush">
                    <a asp-controller="Member" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded">
                        <i class="bi bi-speedometer2 text-primary"></i> Dashboard Overview
                    </a>
                    <a asp-controller="Member" asp-action="Profile" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded">
                        <i class="bi bi-person-gear text-primary"></i> My Profile
                    </a>
                    <a asp-controller="Member" asp-action="Queries" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded">
                        <i class="bi bi-chat-left-dots text-primary"></i> My Queries &amp; Tickets
                    </a>
                    <a asp-controller="Member" asp-action="Invitations" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded">
                        <i class="bi bi-envelope-heart text-primary"></i> Invite Friends
                    </a>
                    <a asp-controller="Programme" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded">
                        <i class="bi bi-calendar-check text-primary"></i> Browse Programmes
                    </a>
                    <a asp-controller="Donation" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 border-0 rounded text-success fw-bold">
                        <i class="bi bi-heart-fill"></i> Make a Donation
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Member Main Content -->
        <div class="col-lg-9 col-md-8">
            @RenderBody()
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
