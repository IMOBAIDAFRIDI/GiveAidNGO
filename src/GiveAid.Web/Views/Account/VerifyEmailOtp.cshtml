@model GiveAid.Web.Models.ViewModels.Account.VerifyEmailOtpViewModel
@{
    Layout = "_CleanLayout";
    ViewData["Title"] = "Verify Email OTP";
}

<div class="container-fluid p-0 auth-split-wrapper">
    <div class="row g-0 w-100 h-100">
        <!-- Left Side: Compact OTP Verification Card (Fitted, Zero Scroll) -->
        <div class="col-lg-6 col-xl-5 auth-form-column">
            <div class="w-100 mx-auto" style="max-width: 440px;">
                <div class="custom-card p-3 p-xl-4 shadow-2xl border">
                    <!-- Top Header: Title & Back to Website Button -->
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                        <div>
                            <h5 class="fw-bold text-white mb-0">Email Verification</h5>
                            <small class="text-muted" style="font-size: 0.75rem;">One-time registration code</small>
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-custom rounded-pill px-3 py-1 text-nowrap" style="font-size: 0.75rem;">
                            <i class="bi bi-arrow-left me-1"></i> Back to Website
                        </a>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger py-1 px-2 small mb-2 d-flex align-items-center gap-2" style="font-size: 0.78rem;">
                            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                    }

                    <!-- Email & Status Card -->
                    <div class="p-2 px-3 bg-surface rounded-3 border border-secondary border-opacity-25 mb-3 text-center">
                        <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                            <i class="bi bi-envelope-check-fill text-primary"></i>
                            <span class="small text-muted" style="font-size: 0.78rem;">Code sent to:</span>
                            <span class="fw-bold text-white" style="font-size: 0.85rem;">@Model.Email</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-center gap-2">
                            @if (Model.IsLocked)
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-2 py-1 rounded-pill" style="font-size: 0.72rem;">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Resend locked for @Model.LockRemainingMinutes min (2h limit)
                                </span>
                            }
                            else
                            {
                                <span id="otpCountdownBadge" class="badge @(Model.RemainingSeconds > 0 ? "bg-warning bg-opacity-25 text-warning border border-warning" : "bg-danger bg-opacity-25 text-danger border border-danger") px-2 py-1 rounded-pill" style="font-size: 0.72rem;">
                                    <i class="bi bi-clock-history me-1"></i>
                                    <span id="countdownText">
                                        @(Model.RemainingSeconds > 0 ? $"Expires in: {Model.RemainingSeconds}s" : "Code expired")
                                    </span>
                                </span>
                                <span class="text-muted" style="font-size: 0.72rem;">
                                    (Resend @Model.ResendAttemptsUsed/2 used)
                                </span>
                            }
                        </div>
                    </div>

                    <!-- OTP Submission Form -->
                    <form asp-controller="Account" asp-action="VerifyEmailOtp" method="post" id="otpForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-2" style="font-size: 0.75rem;"></div>

                        <div class="mb-3 text-center">
                            <label asp-for="OtpCode" class="form-label small fw-semibold text-muted mb-1" style="font-size: 0.8rem;">Enter 6-Digit Code</label>
                            <input asp-for="OtpCode" 
                                   class="form-control text-center fw-black fs-2 border-0 rounded-3 shadow-inner text-primary py-2" 
                                   maxlength="6" 
                                   autofocus 
                                   autocomplete="one-time-code" 
                                   placeholder="------" 
                                   style="letter-spacing: 12px; font-family: monospace;" />
                            <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block" style="font-size: 0.72rem;"></span>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 fw-bold py-2 mb-2 rounded-pill shadow" style="font-size: 0.9rem;">
                            <i class="bi bi-check2-circle me-1"></i> Verify &amp; Activate Account
                        </button>
                    </form>

                    <!-- Resend & Actions Row -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                        <form asp-controller="Account" asp-action="ResendOtp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@Model.Email" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                            <button type="submit" 
                                    id="resendBtn" 
                                    class="btn btn-outline-custom btn-sm rounded-pill px-3 py-1" 
                                    style="font-size: 0.78rem;" 
                                    @(Model.RemainingSeconds > 0 || Model.IsLocked ? "disabled" : "")>
                                <i class="bi bi-arrow-clockwise me-1"></i> Resend Code
                            </button>
                        </form>

                        <a asp-controller="Account" asp-action="Register" class="text-muted small text-decoration-none hover-white" style="font-size: 0.78rem;">
                            <i class="bi bi-pencil-square me-1"></i> Change Email
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Volunteer & Community Aid Visual -->
        <div class="col-lg-6 col-xl-7 d-none d-lg-block">
            <div class="auth-image-column" style="background-image: url('https://images.unsplash.com/photo-1559027615-cd4628902d4a?q=80&w=1400&auto=format&fit=crop');">
                <div class="auth-image-overlay"></div>
                <div class="auth-image-content">
                    <span class="badge bg-primary-custom text-white fw-bold px-3 py-1 rounded-pill text-uppercase mb-2 small">
                        <i class="bi bi-shield-check me-1"></i> Verified Membership
                    </span>
                    <h2 class="fw-bold text-white mb-2">
                        "Secure, transparent, and direct community action."
                    </h2>
                    <p class="text-white-50 small mb-0" style="max-width: 580px;">
                        Email verification protects funds, volunteer rosters, and emergency ground interventions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let secondsLeft = @Model.RemainingSeconds;
            const isLocked = @(Model.IsLocked ? "true" : "false");
            const resendBtn = document.getElementById("resendBtn");
            const countdownText = document.getElementById("countdownText");
            const countdownBadge = document.getElementById("otpCountdownBadge");

            if (!isLocked && secondsLeft > 0) {
                const interval = setInterval(function () {
                    secondsLeft--;
                    if (secondsLeft > 0) {
                        if (countdownText) countdownText.innerText = "Expires in: " + secondsLeft + "s";
                    } else {
                        clearInterval(interval);
                        if (countdownText) countdownText.innerText = "Code expired";
                        if (countdownBadge) {
                            countdownBadge.classList.remove("bg-warning", "text-warning", "border-warning");
                            countdownBadge.classList.add("bg-danger", "text-danger", "border-danger");
                        }
                        if (resendBtn && !isLocked) {
                            resendBtn.removeAttribute("disabled");
                        }
                    }
                }, 1000);
            }
        });
    </script>
}
