@model GiveAid.Web.Models.ViewModels.Account.ProfileViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "My Profile";
}

<div class="custom-card p-4 p-lg-5 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold mb-1">Manage Profile Information</h4>
            <p class="text-muted small mb-0">Update your contact details, profession, and personal records.</p>
        </div>
        <span class="text-muted small">Member since: @Model.MemberSince.ToString("dd MMM yyyy")</span>
    </div>

    <form asp-controller="Member" asp-action="Profile" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control bg-light" readonly />
                <span class="text-muted small">Email address cannot be modified once verified.</span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+92 300 1234567" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="City" class="form-label fw-semibold"></label>
                <input asp-for="City" class="form-control" placeholder="City of residence" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Profession" class="form-label fw-semibold"></label>
                <input asp-for="Profession" class="form-control" placeholder="Occupation or area of expertise" />
            </div>
            <div class="col-md-6">
                <label asp-for="Gender" class="form-label fw-semibold"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Address" class="form-label fw-semibold"></label>
            <textarea asp-for="Address" rows="2" class="form-control" placeholder="Street address"></textarea>
        </div>

        <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">
            <i class="bi bi-check2-circle me-1"></i> Save Profile Changes
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
