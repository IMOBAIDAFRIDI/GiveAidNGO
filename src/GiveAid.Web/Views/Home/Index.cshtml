@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Category Filter for Causes
            const filterButtons = document.querySelectorAll('.cause-filter-btn');
            const causeItems = document.querySelectorAll('.cause-item');

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'btn-primary-custom');
                        b.classList.add('btn-outline-custom');
                    });
                    btn.classList.add('active', 'btn-primary-custom');
                    btn.classList.remove('btn-outline-custom');

                    const targetFilter = btn.dataset.filter;
                    causeItems.forEach(item => {
                        if (targetFilter === 'all' || item.dataset.category === targetFilter) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });

            // Interactive Impact Calculator Tiers
            const impactButtons = document.querySelectorAll('.impact-btn');
            const impactIcon = document.getElementById('impactIcon');
            const impactTitle = document.getElementById('impactTitle');
            const impactMetric = document.getElementById('impactMetric');
            const impactDesc = document.getElementById('impactDesc');
            const impactDonateBtn = document.getElementById('impactDonateBtn');
            const impactAmountDisplay = document.getElementById('impactAmountDisplay');

            if (impactButtons.length > 0) {
                impactButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        impactButtons.forEach(b => b.classList.remove('active', 'btn-primary-custom'));
                        btn.classList.add('active');

                        const amount = btn.dataset.amount;
                        const title = btn.dataset.title;
                        const desc = btn.dataset.desc;
                        const iconClass = btn.dataset.icon;
                        const metric = btn.dataset.metric;

                        if (impactIcon) impactIcon.innerHTML = `<i class="bi ${iconClass}"></i>`;
                        if (impactTitle) impactTitle.textContent = title;
                        if (impactMetric) impactMetric.textContent = metric;
                        if (impactDesc) impactDesc.textContent = desc;
                        if (impactAmountDisplay) impactAmountDisplay.textContent = `$${amount}`;
                        if (impactDonateBtn) impactDonateBtn.href = `/donation?amount=${amount}`;
                    });
                });
            }
        });
    </script>
}
